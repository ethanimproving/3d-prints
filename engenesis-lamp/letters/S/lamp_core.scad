// Parametric Octolamp-Engineered 3D Lamp Base Template
// Units: true printed mm (1:1 scale — NO global X/Z shrinking that would distort hardware pockets).
// Orientation: Viewer looks along +Y (front diffuser face is -Y, rear wall is +Y, X is horizontal, +Z is up).
//
// Companion files expected in the same folder:
//   - shape_pts.scad   (generated by scripts/trace_image_to_scad.py from any 2D silhouette image/SVG)
//   - lamp_base.scad      -> `use <lamp_core.scad> render_lamp_part("base");`
//   - lamp_reflector.scad -> `use <lamp_core.scad> render_lamp_part("reflector");`
//   - lamp_diffuser.scad  -> `use <lamp_core.scad> render_lamp_part("diffuser");`

include <shape_pts.scad>

PART = "base";                    // "base", "reflector", "diffuser", or "assembly"

// ---------- 1. Exact Octolamp Two-Layer Wall Architecture ----------
// Measured directly from octolamp_black_outer_mini_sparkle_motion.stl:
back_wall      = 1.0;             // Rear floor thickness (mm)
bot_wall_h     = 11.0;            // Bottom layer height from inner floor to reflector seat (mm)
top_wall_h     = 13.0;            // Top layer height from reflector seat to front lip (mm)
box_d          = back_wall + bot_wall_h + top_wall_h; // 25.0 mm total exterior depth
top_wall_t     = 3.0;             // Top layer wall thickness (mm)
bot_ledge_w    = 3.0;             // Inward reflector ledge width -> 6.0 mm total bottom wall thickness
diff_clr       = 0.50;            // Radial clearance between base inner wall and diffuser skirt outer face (mm)
diff_wall      = 1.00;            // Hollow diffuser skirt & front face thickness (mm, from octolamp_white_inner.stl)
diff_skirt_len = 12.00;           // Skirt length from bevel base (-13.50 mm) back to reflector face (-1.50 mm)
diff_proud_sk  = 1.00;            // Skirt extends 1.00 mm proud of base front lip (-12.50 -> -13.50 mm)
diff_bevel     = 3.00;            // 45 deg front bevel height & radial inset (front face at -16.50 mm, 4.00 mm proud)
tab_w          = 13.20;           // Snap tab width (mm, 0.60 mm side clearance inside 14.41 mm base groove)
tab_y_span     = 3.00;            // 45 deg V-ridge length along Y (centered at base groove apex)
tab_protrude   = 1.50;            // Outward protrusion from skirt (+1.00 mm into 1.37 mm base groove)
reflector_t    = 2.0;             // White reflector plate thickness (mm)
reflector_clr  = 0.75;            // Perimeter clearance around reflector inside 3.0 mm top wall (from octolamp_white_reflector.stl)
refl_pocket_w  = 16.00;           // Reflector rounded cable pocket width (mm, from octolamp_white_reflector_laser.dxf)
refl_pocket_h  = 9.00;            // Reflector rounded cable pocket height (mm, R = 2.00 mm)
refl_pocket_r  = 2.00;            // Reflector cable pocket corner radius (mm)
refl_slit_h    = 1.50;            // Reflector side-entry wire slit height (mm, opens through nearest side edge)
refl_slit_dir  = rec_slit_dir;    // +1 opens slit to +X edge, -1 opens slit to -X edge

front_y        = -box_d / 2;                      // -12.5 mm
back_y         =  box_d / 2;                      // +12.5 mm
back_in_y      =  back_y - back_wall;             // +11.5 mm
seat_y         =  back_in_y - bot_wall_h;         //  +0.5 mm (reflector rests here)
refl_y0        =  seat_y - reflector_t;           //  -1.5 mm

// ---------- 2. Exact Octolamp Diffuser Snap V-Grooves ----------
snap_w         = 14.41;           // Snap groove horizontal span (mm)
snap_y_inset   = 2.22;            // Starts 2.22 mm behind front lip (Y = -10.28 mm)
snap_y_span    = 2.88;            // 45 deg V-groove span along Y (Y = -10.28 .. -7.40 mm)
snap_depth     = 1.37;            // Peak groove depth into 3.0 mm top wall (leaves 1.63 mm outer skin)
snap_top_x     = rec_snap_top_x;  // X center of top crown snap groove
snap_bot_x     = rec_snap_bot_x;  // X center of bottom foot snap groove

// ---------- 3. Exact Octolamp Sparkle Motion Mini Controller Bay ----------
include_controller = true;
chip_x         = rec_chip_x;      // X center of controller bay
chip_z         = top_wall_t + rec_chip_z; // Z center of controller bay (offset by bottom wall)
tray_in_x      = 22.4;            // Inner pocket width (20 mm board + 2.4 mm clearance)
tray_in_z      = 33.8;            // Inner pocket height (30 mm board + 3.8 mm clearance)
tray_wall      = 1.6;
tray_out_x     = tray_in_x + 2 * tray_wall; // 25.6 mm
tray_out_z     = tray_in_z + 2 * tray_wall; // 37.0 mm
tray_r_out     = 4.0;
tray_r_in      = 2.4;
tray_h         = 9.75;            // Total frame height above inner floor (0.5 mm top chamfer)
pin_base_d     = 5.0;             // Stepped PCB standoff base diameter
pin_base_h     = 1.35;            // Stepped PCB standoff height
pin_d          = 2.2;             // Locating pin diameter
pin_h          = 5.95;            // Locating pin total height above floor
pin_x          = 7.30;            // +/-7.30 mm X pitch
pin_dz         = 12.70;           // +/-12.70 mm Z pitch around (Z_center - 1.0 mm)

// ---------- 4. Exact Octolamp Keyhole, Zip-Tie Strain Relief & Rear Cable Grooves ----------
cable_x        = rec_cable_x;
keyhole_z      = top_wall_t + rec_keyhole_z;
ziptie_z       = top_wall_t + rec_ziptie_z;
foot_ridge_top = max(keyhole_z - 7.1 + 0.2, z_base + rear_groove_z + rear_groove_h / 2 + 2.0); // Thicker 11 mm bottom shelf fills up to top of keyhole neck (and always above rear groove)
rear_groove_h  = 4.0;             // Horizontal rear cable groove height (mm)
rear_groove_d  = 6.0;             // Total depth from rear face (4.01 mm straight + 45 deg roof bevel)
rear_groove_z  = 7.0;             // Z center of horizontal rear cable groove across bottom foot
enable_rear_horiz_groove = true;

// ---------- 5. Reflector Standoff Pillars ----------
pillar_d       = 6.0;             // Octolamp pillar diameter (mm)
pillars_xz     = rec_pillars;     // List of [x, z_interior] coordinates in mm

// ---------- 6. Cubicle Divider Clip ----------
enable_divider_clip = true;
clip_x         = 16;
divider_t      = 22.41;           // Measured divider thickness (mm)
clip_leg_t     = 3.0;
clip_leg_len   = 7.70;
clip_roof_t    = 1.40;
clip_w         = 9.10;

// ---------- Core Geometry Helpers ----------
// Shift interior baseline so outer bottom of the 3.0 mm wall rests at Z = z_base
z_base = enable_divider_clip ? clip_roof_t : 0;
z0     = z_base + top_wall_t;

// Bind $pts and $dpts once per part to stay well under the VS Code OpenSCAD.js 100k evaluation-step limit
module shape_slab(y0, y1, grow = 0) {
    translate([0, (y0 + y1) / 2, z0])
        rotate([90, 0, 0])
            linear_extrude(height = y1 - y0, center = true)
                offset(delta = grow) shape_2d($pts);
}

module diffuser_slab(y0, y1, grow = 0) {
    translate([0, (y0 + y1) / 2, z0])
        rotate([90, 0, 0])
            linear_extrude(height = y1 - y0, center = true)
                offset(delta = grow) diffuser_shape_2d($dpts);
}

module snap_grooves() {
    y_start = front_y + snap_y_inset;
    steps = 6;
    dy = snap_y_span / steps;
    intersection() {
        union() {
            for (k = [0 : steps - 1]) {
                u = (k + 0.5) / steps;
                d = snap_depth * (1 - abs(2 * u - 1));
                shape_slab(y_start + k * dy - 0.02, y_start + (k + 1) * dy + 0.02, d);
            }
        }
        union() {
            // Top crown catch mask
            translate([snap_top_x - snap_w / 2, y_start - 1, z0 + shape_h - 6])
                cube([snap_w, snap_y_span + 2, 12]);
            // Bottom foot catch mask
            translate([snap_bot_x - snap_w / 2, y_start - 1, z0 - 6])
                cube([snap_w, snap_y_span + 2, 12]);
        }
    }
}

module octolamp_chip_holder() {
    difference() {
        hull() {
            translate([0, 0.2, 0]) rotate([90, 0, 0]) linear_extrude(height = tray_h - 0.5 + 0.2)
                offset(r = tray_r_out) square([tray_out_x - 2 * tray_r_out, tray_out_z - 2 * tray_r_out], center = true);
            translate([0, -(tray_h - 0.5), 0]) rotate([90, 0, 0]) linear_extrude(height = 0.5)
                offset(r = tray_r_out - 0.5) square([tray_out_x - 2 * tray_r_out, tray_out_z - 2 * tray_r_out], center = true);
        }
        // Rounded inner pocket
        translate([0, 0.01, 0]) rotate([90, 0, 0]) linear_extrude(height = tray_h + 1)
            offset(r = tray_r_in) square([tray_in_x - 2 * tray_r_in, tray_in_z - 2 * tray_r_in], center = true);

        // Enclosed South USB-C rounded window (10.4 x 5.0 mm, R = 1.0 mm, leaving 2.80 mm top bridge)
        translate([0, -(2.45 + 2.50), -tray_out_z / 2])
            rotate([90, 0, 0]) linear_extrude(height = 6.0, center = true)
                offset(r = 1.0) square([10.4 - 2.0, 5.0 - 2.0], center = true);

        // Top 3-pin terminal-block wire exit
        translate([0, -(tray_h + 1) / 2 - 3.15, tray_out_z / 2]) {
            cube([8.0, tray_h + 1, 6.0], center = true);
            translate([0, -3.2, 0]) cube([11.0, tray_h - 5, 6.0], center = true);
        }

        // Right-wall component clearance window
        translate([tray_out_x / 2, -5.5, 1.6])
            cube([6.0, 7.5, 16.8], center = true);
    }

    // Inner lid-retention snap ribs (compatible with octolamp_black_outer_mini_sparkle_motion_top.stl)
    translate([-(tray_in_x / 2 - 0.5), -(tray_h - 1.0), 0])
        hull() {
            translate([0.45, 0, 0]) cube([0.1, 0.5, 19.0], center = true);
            translate([-0.55, 0, 0]) cube([0.3, 1.9, 20.0], center = true);
        }
    for (seg = [[-8.4, 3.2], [10.5, 1.0]])
        translate([tray_in_x / 2 - 0.5, -(tray_h - 1.0), seg[0]])
            hull() {
                translate([-0.45, 0, 0]) cube([0.1, 0.5, seg[1]], center = true);
                translate([0.55, 0, 0]) cube([0.3, 1.9, seg[1] + 0.4], center = true);
            }

    // 4 stepped PCB standoffs + locating pins
    for (sx = [-1, 1]) for (sz = [-1, 1])
        translate([sx * pin_x, 0.2, -1.0 + sz * pin_dz]) rotate([90, 0, 0]) {
            cylinder(h = pin_base_h + 0.2, d = pin_base_d, $fn = 28);
            cylinder(h = pin_h + 0.2, d = pin_d, $fn = 24);
        }
}

module cable_and_rear_grooves() {
    // 1. Two D = 5.0 mm zip-tie strain-relief holes
    for (sx = [-1, 1])
        translate([cable_x + sx * 5.0, back_in_y - 0.5, ziptie_z])
            rotate([-90, 0, 0]) cylinder(h = back_wall + 1.5, d = 5.0, $fn = 28);

    // 2. Keyhole pass-through (D = 14.2 mm plug circle + straight 4.0 mm retention neck, 45 deg inner chamfer)
    for (pass = [[0, -0.2, back_wall + 0.6], [0.8, -0.05, 0.65]]) {
        grow = pass[0];
        y0 = back_in_y + pass[1];
        th = pass[2];
        translate([cable_x, y0 + th / 2, 0]) rotate([90, 0, 0])
            linear_extrude(height = th, center = true) offset(delta = grow) union() {
                translate([0, keyhole_z]) circle(d = 14.2, $fn = 40);
                translate([-2.0, z0 + bot_ledge_w]) square([4.0, keyhole_z - (z0 + bot_ledge_w)]);
            }
    }

    // 3. Vertical rear cable channel (5.0 x 6.0 mm with 45 deg beveled inner roof) out the bottom wall
    hull() {
        translate([cable_x - 2.5, back_y - 4.0, z_base - 1.0])
            cube([5.0, 4.5, foot_ridge_top - z_base + 1.5]);
        translate([cable_x - 0.5, back_y - 6.0, z_base - 1.0])
            cube([1.0, 6.5, foot_ridge_top - z_base + 1.5]);
    }

    // 4. Optional horizontal rear cable groove (4.0 x 6.0 mm, 45 deg beveled roof) across the bottom foot
    if (enable_rear_horiz_groove) {
        w_span = shape_w + 2 * top_wall_t + 10;
        hull() {
            translate([-w_span / 2, back_y - 4.01, z_base + rear_groove_z - rear_groove_h / 2])
                cube([w_span, 4.5, rear_groove_h]);
            translate([-w_span / 2, back_y - rear_groove_d, z_base + rear_groove_z - 0.02])
                cube([w_span, rear_groove_d + 0.5, 0.04]);
        }
    }
}

module reflector_seat_and_pillars() {
    yc = (seat_y + back_in_y + 0.5) / 2;
    union() {
        // 11.0 mm tall x 3.0 mm inward reflector ledge (-> 6.0 mm total bottom wall thickness)
        translate([0, yc, z0]) rotate([90, 0, 0])
            linear_extrude(height = back_in_y + 0.5 - seat_y, center = true)
                difference() {
                    shape_2d($pts);
                    offset(delta = -bot_ledge_w) shape_2d($pts);
                }

        // Thicker bottom foot shelf up to top of keyhole neck
        if (include_controller)
            intersection() {
                shape_slab(seat_y, back_in_y + 0.5, 0);
                translate([-shape_w, seat_y - 1, z_base])
                    cube([2 * shape_w, back_in_y - seat_y + 2, foot_ridge_top - z_base]);
            }

        // D = 6.0 mm standoff pillars clipped cleanly inside the reflector ledge
        if (len(pillars_xz) > 0)
            intersection() {
                union() {
                    for (p = pillars_xz)
                        translate([p[0], yc, z0 + p[1]])
                            rotate([90, 0, 0])
                                cylinder(h = back_in_y + 0.5 - seat_y, d = pillar_d, center = true, $fn = 24);
                }
                shape_slab(seat_y, back_in_y + 0.5, -bot_ledge_w);
            }
    }
}

module divider_clip() {
    outer_half = divider_t / 2 + clip_leg_t;
    translate([clip_x - clip_w / 2, -outer_half, 0])
        cube([clip_w, 2 * outer_half, clip_roof_t + 0.5]);
    for (s = [-1, 1])
        translate([clip_x - clip_w / 2, s > 0 ? divider_t / 2 : -outer_half, -clip_leg_len])
            cube([clip_w, clip_leg_t, clip_leg_len]);
}

module lamp_base() {
    union() {
        difference() {
            shape_slab(front_y, back_y, top_wall_t);
            shape_slab(front_y - 1, back_in_y, 0);
            snap_grooves();
            if (include_controller) cable_and_rear_grooves();
        }
        if (include_controller)
            intersection() {
                translate([chip_x, back_in_y, chip_z]) octolamp_chip_holder();
                shape_slab(back_in_y - tray_h - 1, back_in_y + 1, 0);
            }
        difference() {
            reflector_seat_and_pillars();
            if (include_controller) cable_and_rear_grooves();
        }
        if (enable_divider_clip) divider_clip();
    }
}

module lamp_reflector() {
    px = cable_x - 0.47 * refl_slit_dir;
    pz = ziptie_z;
    difference() {
        shape_slab(refl_y0, seat_y, -reflector_clr);
        if (include_controller)
            translate([0, (refl_y0 + seat_y) / 2, 0])
                rotate([90, 0, 0])
                    linear_extrude(height = reflector_t + 2, center = true) union() {
                        // 16.00 x 9.00 mm rounded rectangular cable pocket (R = 2.00 mm)
                        translate([px, pz])
                            offset(r = refl_pocket_r, $fn = 28)
                                square([refl_pocket_w - 2 * refl_pocket_r, refl_pocket_h - 2 * refl_pocket_r], center = true);
                        // 1.50 mm wide horizontal entry slit opening out the nearest side edge
                        translate([refl_slit_dir > 0 ? px : px - shape_w, pz - refl_slit_h / 2])
                            square([shape_w, refl_slit_h]);
                    }
    }
}

module lamp_diffuser() {
    y_bevel_base = front_y - diff_proud_sk;           // -13.50 mm
    y_back       = y_bevel_base + diff_skirt_len - 0.02; // -1.52 mm (clears reflector at -1.50 mm)
    bevel_steps  = 8;
    dy_bev       = diff_bevel / bevel_steps;

    y_snap_mid   = front_y + snap_y_inset + snap_y_span / 2; // -8.84 mm
    y_tab0       = y_snap_mid - tab_y_span / 2;
    tab_steps    = 6;
    dy_tab       = tab_y_span / tab_steps;

    union() {
        difference() {
            union() {
                diffuser_slab(y_bevel_base, y_back, -diff_clr);
                for (k = [0 : bevel_steps - 1]) {
                    inset_mm = diff_clr + diff_bevel * ((k + 0.5) / bevel_steps);
                    diffuser_slab(y_bevel_base - (k + 1) * dy_bev - 0.02, y_bevel_base - k * dy_bev + 0.02, -inset_mm);
                }
            }
            union() {
                diffuser_slab(y_bevel_base + diff_wall, y_back + 1.0, -(diff_clr + diff_wall));
                for (k = [0 : bevel_steps - 1]) {
                    inset_mm = diff_clr + diff_wall + diff_bevel * ((k + 0.5) / bevel_steps);
                    diffuser_slab(y_bevel_base + diff_wall - (k + 1) * dy_bev - 0.02, y_bevel_base + diff_wall - k * dy_bev + 0.02, -inset_mm);
                }
            }
        }
        intersection() {
            difference() {
                union() {
                    for (k = [0 : tab_steps - 1]) {
                        u = (k + 0.5) / tab_steps;
                        out_mm = -diff_clr + tab_protrude * (1 - abs(2 * u - 1));
                        diffuser_slab(y_tab0 + k * dy_tab - 0.02, y_tab0 + (k + 1) * dy_tab + 0.02, out_mm);
                    }
                }
                diffuser_slab(y_tab0 - 0.5, y_tab0 + tab_y_span + 0.5, -(diff_clr + 0.4));
            }
            union() {
                translate([snap_top_x - tab_w / 2, y_tab0 - 1, z0 + shape_h - 6])
                    cube([tab_w, tab_y_span + 2, 12]);
                translate([snap_bot_x - tab_w / 2, y_tab0 - 1, z0 - 6])
                    cube([tab_w, tab_y_span + 2, 12]);
            }
        }
    }
}

module render_lamp_part(part = PART) {
    let($pts = shape_pts, $dpts = diffuser_shape_pts) {
        if (part == "base") lamp_base();
        else if (part == "reflector") lamp_reflector();
        else if (part == "diffuser") lamp_diffuser();
        else {
            color("#111827") lamp_base();
            color("white") lamp_reflector();
            color([0.75, 0.9, 1, 0.85]) lamp_diffuser();
        }
    }
}

render_lamp_part();
